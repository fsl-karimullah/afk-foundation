# ==============================================================
# AFK FOUNDATION ENVIRONMENT VARIABLES (TEMPLATE)
# ==============================================================
# Copy file ini menjadi .env.local untuk local development
# Atau tambahkan variabel ini di Dashboard Vercel (Project Settings -> Environment Variables)

# 1. DATABASE: MongoDB Atlas Connection String
# Format: mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/afk_foundation?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/afk_foundation?retryWrites=true&w=majority

# 2. ADMIN CREDENTIALS (Disimpan aman di server, tidak bocor ke client)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here

# 3. JWT SECRET FOR ADMIN SESSION (Minimal 32 karakter acak)
JWT_SECRET=super_secret_afk_foundation_key_change_in_production_32chars!

# 4. CLOUDINARY (Penyimpanan Foto Bukti Transfer & Dokumentasi Gerakan)
# Ambil dari Cloudinary Dashboard: Settings / API Keys
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
